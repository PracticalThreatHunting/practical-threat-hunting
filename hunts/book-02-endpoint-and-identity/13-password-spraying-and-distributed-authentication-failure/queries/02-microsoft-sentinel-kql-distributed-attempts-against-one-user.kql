// Book 2, Hunt 13: Password Spraying and Distributed Authentication Failure
// Section: Microsoft Sentinel KQL - Distributed Attempts Against One User
// Reference implementation: validate live schema, fields, licensing, and thresholds before use.

let Window = 30m;
SigninLogs
| where TimeGenerated > ago(24h)
| where tostring(ResultType) != "0"
| summarize Attempts=count(),
            SourceCount=dcount(IPAddress),
            Sources=make_set(IPAddress, 30),
            UserAgents=make_set(UserAgent, 15),
            Apps=make_set(AppDisplayName, 15)
  by UserId, UserPrincipalName, bin(TimeGenerated, Window)
| where SourceCount >= 5 and Attempts >= 8
| order by SourceCount desc
