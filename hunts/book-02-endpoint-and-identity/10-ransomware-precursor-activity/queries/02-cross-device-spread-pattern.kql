// Book 2, Hunt 10: Ransomware Precursor Activity
// Section: Cross-Device Spread Pattern
// Reference implementation: validate live schema, fields, licensing, and thresholds before use.

let DeviceThreshold = 5; // Tune from a peer-group baseline.
DeviceLogonEvents
| where Timestamp > ago(24h)
| where ActionType =~ "LogonSuccess"
| summarize Devices=dcount(DeviceId), DeviceList=make_set(DeviceName, 50),
            FirstSeen=min(Timestamp), LastSeen=max(Timestamp)
  by AccountSid, AccountName, RemoteIP, LogonType
| where Devices >= DeviceThreshold
| order by Devices desc
