// Book 2, Hunt 04: Process Injection and Memory-Resident Behavior
// Section: Microsoft Defender XDR KQL - Schema-Discovery Pattern
// Reference implementation: validate live schema, fields, licensing, and thresholds before use.

DeviceEvents
| where Timestamp > ago(30d)
| where ActionType contains "Injection"
    or ActionType contains "RemoteThread"
    or ActionType contains "ProcessAccess"
| summarize Events=count(), Devices=dcount(DeviceId),
            Examples=make_set(AdditionalFields, 3)
  by ActionType, InitiatingProcessFileName
| order by Events asc
