// Book 2, Hunt 01: Suspicious PowerShell Chains
// Section: Establish Normal
// Reference implementation: validate live schema, fields, licensing, and thresholds before use.

DeviceProcessEvents
| where Timestamp > ago(30d)
| where FileName in~ ("powershell.exe", "pwsh.exe")
| extend Parent = tolower(InitiatingProcessFileName)
| extend CmdPrefix = substring(tolower(ProcessCommandLine), 0, 120)
| summarize Executions=count(), Devices=dcount(DeviceId),
            Users=dcount(AccountSid), Examples=make_set(ProcessCommandLine, 3)
  by Parent, CmdPrefix
| order by Executions desc
